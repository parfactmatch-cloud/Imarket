# Jev Engine configuration. Copy to .env for local runs (never commit .env).
# In GitHub Actions these come from repository Secrets instead.

# --- Fyers broker (required for live feed) ---
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ID=
FYERS_PIN=
FYERS_TOTP_KEY=
# Optional: override the computed weekly (Thursday) expiry, e.g. when
# the Thursday is a trading holiday. Format: YYYY-MM-DD.
FYERS_EXPIRY_OVERRIDE=
# Optional: use a pre-obtained access token instead of the Playwright login.
FYERS_ACCESS_TOKEN=

# --- Telegram remote control (required for alerts / commands) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Trading mode and risk controls ---
# PAPER_MODE defaults to True. Set to False ONLY for live trading with
# real funds, after reviewing the README's live-mode checklist.
PAPER_MODE=True
# NIFTY option lot size (do not change unless the exchange changes it).
LOT_SIZE=75
# Maximum realised loss per day (Rs). New entries are blocked past it.
MAX_DAILY_LOSS_RS=10000
# Maximum new trades per day.
MAX_TRADES_PER_DAY=3
# Maximum simultaneous open positions.
MAX_OPEN_POSITIONS=1
# Starting virtual cash for paper mode (Rs).
VIRTUAL_CASH_INITIAL=200000
# End-of-day square-off and shutdown times (HH:MM IST).
SQUARE_OFF_TIME=15:20
MARKET_CLOSE_TIME=15:31
# Fallback loop iterations when no Fyers token is available.
MAX_ITERATIONS=10
# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
